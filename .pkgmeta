package-as: HammerLink
enable-nolib-creation: no

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

license-output: LICENSE.txt

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - tests
  - Copy-ToWoWAddons.local.ps1
  - CHANGELOG.md
  # Project/source artwork is uploaded separately. Only the TGA textures used
  # by the game belong in the addon archive.
  - Textures/HammerLink-curseforge-400.png
  - Textures/HammerLinkClean.png
